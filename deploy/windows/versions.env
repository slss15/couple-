# Pinned third-party binaries for the Windows package. Bump version AND sha256 together (sha256 of the exact asset).
# Read by build-package.sh (CI) and, inside the zip, by install.ps1 and setup.ps1.

# Temurin JDK used for cross-jlink: the jlink host JDK (Linux) must be the *same release* as the Windows jmods.
TEMURIN_RELEASE=jdk-21.0.12.1+1
TEMURIN_LINUX_X64_SHA256=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94
TEMURIN_LINUX_AARCH64_SHA256=23e37e026f12f3e706f18938ff611db3032d075b09d0879a25d06718c773e223
TEMURIN_WINDOWS_X64_SHA256=f9d6e191ab098c0d416e7d588a24420a8621cd2f4720dab2459b8b7b2d2d8b4e

# Modules of the bundled JRE (jdeps of backend + updater, plus runtime-only: TLS EC, charsets, zipfs, management).
JLINK_MODULES=java.base,java.compiler,java.desktop,java.instrument,java.management,java.naming,java.net.http,java.security.sasl,java.sql,java.xml,jdk.net,jdk.unsupported,jdk.httpserver,jdk.crypto.ec,jdk.charsets,jdk.zipfs,jdk.management

# WinSW 2.x service wrapper (.NET Framework 4.6.1 build; Windows Server 2016+/Win10+ ship .NET 4.7+).
WINSW_VERSION=v2.12.0
WINSW_ASSET=WinSW.NET461.exe
WINSW_SHA256=b5066b7bbdfba1293e5d15cda3caaea88fbeab35bd5b38c41c913d492aadfc4f

# cloudflared for Windows, downloaded by install.ps1 (never "latest").
CLOUDFLARED_VERSION=2026.10.3
CLOUDFLARED_WINDOWS_AMD64_SHA256=76b2805253d0d6ffacb092a7acfbee99e7af6917835c0c5410e23f3ef5052da2

# MySQL 8.4 LTS Windows x64 ZIP (no-install), downloaded by setup.ps1 when no MySQL service exists.
# Current release: https://cdn.mysql.com/Downloads/MySQL-8.4/mysql-<v>-winx64.zip; once superseded it moves to
# https://cdn.mysql.com/archives/mysql-8.4/mysql-<v>-winx64.zip (setup.ps1 tries both). sha256 computed from the
# downloaded file; its MD5 matches the one published on dev.mysql.com/downloads/mysql/8.4.html.
MYSQL_VERSION=8.4.13
MYSQL_WINDOWS_X64_SHA256=e9cd98b1d23f122987b1afca26ad942efec5891481103d48ae3cde237fa3ea54
