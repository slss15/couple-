# Couple 服务器配置（Windows 原生部署）。setup.ps1 / install.ps1 首次运行时复制为 C:\couple\config\couple.env。
# 用 setup.ps1 一键安装时【这个文件一个字都不用改】：标“自动”的值都由脚本生成/填写（已存在的非空值绝不覆盖），
# 其余都是可选项，保持默认即可。
# 格式：每行 KEY=VALUE，# 开头为注释，值不需要引号，不支持变量展开。修改后重启对应服务：
#   Restart-Service couple-backend    （或 couple-updater）
# 文件含密钥：install.ps1 已把权限收紧为仅 Administrators / SYSTEM 可读。
# 每个变量的详细说明见 deploy/windows/SETUP-windows.md 附录第 4 节。

# ===== 1. 数据库（MySQL 8.4，本机） =====
# 可选：默认就是本机 MySQL 的 couple 库
DB_URL=jdbc:mysql://127.0.0.1:3306/couple?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=couple
# 自动：setup.ps1 创建数据库 couple 和同名用户后写入（手动装 MySQL 时填你设置的密码）
DB_PASSWORD=

# ===== 2. 后端 =====
# 自动：≥32 字符的随机串。修改后所有人需要重新登录
JWT_SECRET=
# 自动：首次设置页的一次性令牌（setup.ps1 生成），打开 https://<域名>/setup?token=<SETUP_TOKEN> 创建管理员
SETUP_TOKEN=
# 可选：注册邀请码；留空 = 关闭注册（两人都注册完后建议清空）
REGISTRATION_CODE=
# 自动：updater 上报状态用的内部令牌（X-Internal-Token）
MQTT_HOOK_SECRET=
# 可选：Ed25519 引导签名私钥（base64 的 PKCS#8 DER 或 32 字节 seed）。留空 = 首次启动自动生成并存进数据库
BOOTSTRAP_PRIVATE_KEY=
# 可选：指定管理员用户名；留空 = 第一个注册的用户成为管理员
ADMIN_USERNAME=
# 可选：注册/登录每 IP 每分钟上限
AUTH_RATE_LIMIT_PER_MINUTE=30
# 可选：访问 GitHub（版本镜像、updater 下载）的出站代理，如 http://127.0.0.1:7890
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
# 可选：后端 HTTP 端口。注意：cloudflared 的 config.yml 固定指向 127.0.0.1:8080/8083/9000，改端口需同步改 config\cloudflared\config.yml
PORT=8080
# 自动：JVM 参数。setup.ps1 按内存填写（≤2.5 GB → -Xmx384m，≤5 GB → -Xmx640m，更大 → -Xmx1024m）；
# 改成别的值后 setup.ps1 不再动它。留空 = -Xms64m -Xmx512m …。写进服务配置，下次部署或执行 install.ps1 后生效
JAVA_OPTS=

# ===== 3. MQTT（内置 Moquette broker） =====
# embedded = 后端内置 broker（Windows 默认）；external = 外部 EMQX（仅 Docker 方案）
MQTT_BROKER_MODE=embedded
# WebSocket 端口与绑定地址：只给本机 cloudflared 用，保持 127.0.0.1
MQTT_WS_PORT=8083
MQTT_BIND_HOST=127.0.0.1
# 可选：纯 TCP MQTT 端口（调试用，同样只绑定 MQTT_BIND_HOST）；留空 = 关闭
MQTT_TCP_PORT=
# 持久会话（cleanSession=false）多久不上线就清除，同时限制离线排队消息的总量
MQTT_SESSION_EXPIRY=7d
# 持久化目录默认 C:\couple\data\mqtt（服务配置里设置）；一般不用改
# MQTT_DATA_DIR=

# ===== 4. 管理后台 =====
# 管理后台调 API 的地址；留空 = 同域（推荐）
COUPLE_API_BASE=

# ===== 5. 推送即部署 / 自动更新（couple-updater） =====
# 自动：必须与 GitHub Secret DEPLOY_HOOK_SECRET 相同（setup.ps1 结束时会打印出来）。留空 = 关闭 webhook，只轮询
DEPLOY_HOOK_SECRET=
# 可选：false = 停止一切自动部署（webhook 返回 503，轮询不执行）
UPDATE_ENABLED=true
# 可选：edge = 每次推 main 都部署；stable = 只跟正式版；0.2.0 = 固定版本
UPDATE_CHANNEL=edge
# 可选：轮询间隔（秒，最少 30）
UPDATE_INTERVAL=300
# 可选：轮询时段（本机时区），如 03:00-05:00，可跨午夜；webhook 不受限
UPDATE_WINDOW=
# 可选：部署后健康检查超时（秒），超时即回滚
HEALTH_TIMEOUT=90
# 可选：允许下载安装包的 GitHub 仓库（白名单）
UPDATE_REPO=slss15/couple-
# 可选：GitHub API token（只读），仓库私有或 API 限流时填写
UPDATE_GITHUB_TOKEN=
