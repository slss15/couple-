# Couple 服务器配置（Windows 原生部署）。install.ps1 首次安装时复制为 C:\couple\config\couple.env，
# 并自动生成 JWT_SECRET / MQTT_HOOK_SECRET / DEPLOY_HOOK_SECRET（已存在的值绝不覆盖）。
# 格式：每行 KEY=VALUE，# 开头为注释，值不需要引号，不支持变量展开。修改后重启对应服务：
#   Restart-Service couple-backend    （或 couple-updater）
# 文件含密钥：install.ps1 已把权限收紧为仅 Administrators / SYSTEM 可读。
# 每个变量的详细说明见 deploy/windows/SETUP-windows.md 第 5 节。

# ===== 1. 数据库（MySQL 8.4，本机） =====
DB_URL=jdbc:mysql://127.0.0.1:3306/couple?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=couple
# 必填：创建 MySQL 用户时设置的密码
DB_PASSWORD=

# ===== 2. 后端 =====
# 必填，≥32 字符（install.ps1 自动生成）。修改后所有人需要重新登录
JWT_SECRET=
# 注册邀请码；留空 = 关闭注册（两人都注册完后建议清空）
REGISTRATION_CODE=
# updater 上报状态用的内部令牌（X-Internal-Token），install.ps1 自动生成
MQTT_HOOK_SECRET=
# 可选：Ed25519 引导签名私钥（base64 的 PKCS#8 DER 或 32 字节 seed）。留空 = 首次启动自动生成并存进数据库
BOOTSTRAP_PRIVATE_KEY=
# 可选：指定管理员用户名；留空 = 第一个注册的用户成为管理员
ADMIN_USERNAME=
AUTH_RATE_LIMIT_PER_MINUTE=30
# 可选：访问 GitHub（版本镜像、updater 下载）的出站代理，如 http://127.0.0.1:7890
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
# 后端 HTTP 端口（cloudflared 的 config.yml 也指向它）
PORT=8080
# JVM 参数（写进服务配置，下次部署或执行 install.ps1 后生效）。2 GB 主机建议 -Xmx384m，4 GB 主机 -Xmx512m～768m
JAVA_OPTS=-Xms64m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError

# ===== 3. MQTT（内置 Moquette broker） =====
# embedded = 后端内置 broker（Windows 默认）；external = 外部 EMQX（仅 Docker 方案）
MQTT_BROKER_MODE=embedded
# WebSocket 端口与绑定地址：只给本机 cloudflared 用，保持 127.0.0.1
MQTT_WS_PORT=8083
MQTT_BIND_HOST=127.0.0.1
# 可选：纯 TCP MQTT 端口（调试用，同样只绑定 MQTT_BIND_HOST）；留空 = 关闭
MQTT_TCP_PORT=
# 持久会话（cleanSession=false）多久不上线就清除，同时限制离线排队消息的总量
MQTT_SESSION_EXPIRY=7d
# 持久化目录默认 C:\couple\data\mqtt（服务配置里设置）；一般不用改
# MQTT_DATA_DIR=

# ===== 4. 管理后台 =====
# 管理后台调 API 的地址；留空 = 同域（推荐）
COUPLE_API_BASE=

# ===== 5. 推送即部署 / 自动更新（couple-updater） =====
# 必须与 GitHub Secret DEPLOY_HOOK_SECRET 相同（install.ps1 自动生成，复制到 GitHub）。留空 = 关闭 webhook，只轮询
DEPLOY_HOOK_SECRET=
# false = 停止一切自动部署（webhook 返回 503，轮询不执行）
UPDATE_ENABLED=true
# edge = 每次推 main 都部署；stable = 只跟正式版；0.2.0 = 固定版本
UPDATE_CHANNEL=edge
# 轮询间隔（秒，最少 30）
UPDATE_INTERVAL=300
# 可选：轮询时段（本机时区），如 03:00-05:00，可跨午夜；webhook 不受限
UPDATE_WINDOW=
# 部署后健康检查超时（秒），超时即回滚
HEALTH_TIMEOUT=90
# 允许下载安装包的 GitHub 仓库（白名单）
UPDATE_REPO=slss15/couple-
# 可选：GitHub API token（只读），仓库私有或 API 限流时填写
UPDATE_GITHUB_TOKEN=
