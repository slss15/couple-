# 复制为 .env 后填写；.env 已被 .gitignore 忽略，绝不要提交真实值。
# 生成随机串示例：openssl rand -base64 48

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
DB_USER=couple
DB_PASSWORD=change-me-db
# docker-compose 内部自动拼接 DB_URL；本机直跑后端时才需要手动设置：
# DB_URL=jdbc:mysql://127.0.0.1:3306/couple?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ---- 后端 ----
# 至少 32 个字符
JWT_SECRET=change-me-at-least-32-characters-long-random
# 注册邀请码（私有服务器）。留空 = 关闭注册
REGISTRATION_CODE=change-me-invite
# 可选：Ed25519 私钥（base64 的 PKCS#8 DER 或 32 字节 seed）。
# 生成：openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
# 留空 = 首次启动自动生成并存入数据库（server_settings 表）
BOOTSTRAP_PRIVATE_KEY=
# 可选：指定管理员用户名；留空 = 第一个注册的用户成为管理员
ADMIN_USERNAME=
# EMQX 调用 /internal/mqtt/* 时携带的共享密钥（契约外新增，强烈建议设置）
MQTT_HOOK_SECRET=change-me-hook-secret
PORT=8080

# ---- EMQX ----
EMQX_DASHBOARD_PASSWORD=change-me-dashboard

# ---- 入口（二选一） ----
# 公网域名（Cloudflare 上已托管）
PUBLIC_HOSTNAME=couple.example.com
# 方案 A：DDNS 用的 Cloudflare API Token（权限仅需 Zone:DNS:Edit，限定到该域名）
CLOUDFLARE_API_TOKEN=
# 方案 B：Cloudflare Tunnel 的 token（Zero Trust 面板创建 tunnel 后获得）
CLOUDFLARE_TUNNEL_TOKEN=
