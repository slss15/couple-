# Couple 环境变量模板。复制为 .env 后填写；.env 已被 .gitignore 忽略，绝不要提交真实值。
# 每个变量的说明与生成方法见 deploy/SETUP.md 第 2 节。
# 本文件与 backend/.env.example 保持完全一致（开发栈会忽略只用于生产/自动更新的变量）。
# 通用随机串：openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# ===== 1. MySQL =====
# 必填。MySQL root 密码
MYSQL_ROOT_PASSWORD=
# 后端连接 MySQL 的用户与密码（DB_PASSWORD 必填）
DB_USER=couple
DB_PASSWORD=
# docker compose 内部自动拼接 DB_URL；仅在本机直跑后端时才需要手动设置：
# DB_URL=jdbc:mysql://127.0.0.1:3306/couple?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ===== 2. 后端 =====
# 必填，至少 32 个字符。修改后所有人需要重新登录
JWT_SECRET=
# 注册邀请码。留空 = 关闭注册（两人都注册完后建议清空）
REGISTRATION_CODE=
# EMQX / updater 调用 /api/v1/internal/* 时携带的共享密钥（X-Internal-Token），强烈建议设置
MQTT_HOOK_SECRET=
# 可选：Ed25519 引导签名私钥（base64 的 PKCS#8 DER 或 32 字节 seed）。留空 = 首次启动自动生成并存入数据库
# 生成：openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
BOOTSTRAP_PRIVATE_KEY=
# 可选：指定管理员用户名；留空 = 第一个注册的用户成为管理员
ADMIN_USERNAME=
# 注册/登录/刷新每个 IP 每分钟上限
AUTH_RATE_LIMIT_PER_MINUTE=30
# 可选：版本镜像任务访问 GitHub 用的出站代理，如 http://192.168.1.2:7890
HTTPS_PROXY=
# 镜像文件目录在 compose 里固定为 /data/releases（命名卷 releases-data），无需在此设置 RELEASES_DIR

# ===== 3. EMQX =====
# 必填。EMQX Dashboard（http://127.0.0.1:18083，用户 admin）密码
EMQX_DASHBOARD_PASSWORD=

# ===== 4. 公网入口（Cloudflare，二选一） =====
# 公网域名（已托管在 Cloudflare）
PUBLIC_HOSTNAME=couple.example.com
# 方案 A（--profile aaaa）：DDNS 用的 Cloudflare API Token，权限 Zone:DNS:Edit，只限该域名
CLOUDFLARE_API_TOKEN=
# 方案 B（--profile tunnel）：Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=

# ===== 5. 镜像与自动更新（仅 deploy/docker-compose.yml） =====
# edge = 每次推 main 都部署；stable = 只跟正式版；0.2.0 = 固定版本
COUPLE_TAG=edge
# 推送即部署的 HMAC 密钥，必须与 GitHub Secret DEPLOY_HOOK_SECRET 相同。留空 = 关闭 webhook，只轮询
# 生成：openssl rand -hex 32
DEPLOY_HOOK_SECRET=
# false = 停止一切自动部署（webhook 返回 503，轮询不执行）
UPDATE_ENABLED=true
# 跟踪的镜像 tag；留空 = 跟 COUPLE_TAG 一致
UPDATE_CHANNEL=
# 轮询间隔（秒，最少 30）
UPDATE_INTERVAL=300
# 可选：轮询时段（按 TZ），如 03:00-05:00，可跨午夜；webhook 不受限
UPDATE_WINDOW=
# 部署后健康检查超时（秒），超时即回滚
HEALTH_TIMEOUT=90
# GHCR 包为私有时填写：GitHub 用户名 + 仅 read:packages 权限的 PAT
GHCR_USER=
GHCR_TOKEN=
# updater 的时区（影响 UPDATE_WINDOW 与日志）
TZ=Asia/Shanghai
# 可选：admin 前端调用 API 的地址；留空 = 同域（推荐）
ADMIN_API_BASE=
