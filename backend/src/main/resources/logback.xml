<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="Exposed" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <!-- Embedded MQTT broker: MQTTMessageLogger logs every packet at INFO. -->
    <logger name="io.moquette" level="WARN"/>
    <logger name="io.moquette.broker.Server" level="INFO"/>
    <logger name="io.moquette.broker.MQTTConnection" level="INFO"/>
</configuration>
